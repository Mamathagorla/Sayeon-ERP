#--------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Kolkata'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = operations_erp
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (used to encrypt bank/hosting/FTP credential fields)
# Generate with: php spark key:generate
#--------------------------------------------------------------------
encryption.key =
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null
session.expiration = 7200

#--------------------------------------------------------------------
# STORAGE — local | s3
#--------------------------------------------------------------------
storage.driver = local
storage.localPath = writable/uploads

storage.s3.key =
storage.s3.secret =
storage.s3.region = ap-south-1
storage.s3.bucket =

#--------------------------------------------------------------------
# EMAIL (used by NotificationService and meeting invitations)
# Invitations are only sent when SMTPUser and SMTPPass are both set.
# Gmail: SMTPUser = the full Gmail address, SMTPPass = an App Password
#        (Google Account > Security > App passwords), port 587, crypto tls.
# Hostinger: SMTPHost = smtp.hostinger.com, SMTPUser = the mailbox
#        (e.g. ops@yourdomain.com), port 465 with SMTPCrypto = ssl
#        (or port 587 with tls). Keep fromEmail on the same mailbox.
#--------------------------------------------------------------------
email.fromEmail = ops@sanvima.com
email.fromName = 'Sanvima Operations'
email.SMTPHost = smtp.gmail.com
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.protocol = smtp

#--------------------------------------------------------------------
# WHATSAPP (Meta Cloud API) — leave blank to disable WhatsApp channel
#--------------------------------------------------------------------
whatsapp.provider = meta_cloud
whatsapp.phoneNumberId =
whatsapp.accessToken =

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.superAdminEmail = admin@sanvima.com
